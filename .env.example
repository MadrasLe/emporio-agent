# --- LLM provider -----------------------------------------------------------
# Any OpenAI-compatible endpoint works. Default: OpenRouter (free and paid models
# behind a single key). Get a key at https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Free models are often rate-limited upstream (HTTP 429). OpenRouter tries these, in order, when the
# main model fails. Leave empty to disable.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TEMPERATURE=0.2

# Local alternative (Ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# --- Simulated clock ----------------------------------------------------------
# The dataset ends in March 2026. Pinning "now" keeps order deadlines, late
# deliveries and store hours meaningful. Remove it to use the real clock.
EMPORIO_NOW=2026-03-25T14:30
